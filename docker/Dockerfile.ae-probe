FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/Kms.AeProbe/Kms.AeProbe.csproj
RUN dotnet publish src/Kms.AeProbe/Kms.AeProbe.csproj --configuration Release --output /out --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
USER app
WORKDIR /app
COPY --from=build /out .
ENTRYPOINT ["dotnet", "Kms.AeProbe.dll"]
